-- index idx_agent_hook_event_identity
CREATE INDEX idx_agent_hook_event_identity ON agent_hook_event(agent, session_id) WHERE session_id IS NOT NULL

-- index idx_captured_event_session_turn_kind
CREATE INDEX idx_captured_event_session_turn_kind ON captured_event(session_id, turn_ordinal, kind)

-- index idx_turn_boundary_gap_context
CREATE INDEX idx_turn_boundary_gap_context ON turn_boundary_gap_ticket(context_sha256, gap_id)

-- table _migrations
CREATE TABLE _migrations (
version    INTEGER PRIMARY KEY,
name       TEXT    NOT NULL,
checksum   TEXT    NOT NULL,
applied_at TEXT    NOT NULL
) STRICT

-- table _schema_version
CREATE TABLE _schema_version (
table_name     TEXT PRIMARY KEY,
schema_version INTEGER NOT NULL
) STRICT

-- table agent_enablement
CREATE TABLE agent_enablement (
  change_id TEXT NOT NULL,
  agent TEXT NOT NULL,
  action TEXT NOT NULL,
  changed_at INTEGER NOT NULL,
  wired_hooks_hash TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (change_id)
) STRICT

-- table agent_hook_event
CREATE TABLE agent_hook_event (
  hook_event_id TEXT NOT NULL,
  agent TEXT NOT NULL,
  verb TEXT NOT NULL,
  session_id TEXT,
  received_at INTEGER NOT NULL,
  outcome TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (hook_event_id)
) STRICT

-- table archive_decision
CREATE TABLE archive_decision (
  decision_id TEXT NOT NULL,
  session_id TEXT,
  strategy TEXT NOT NULL,
  reason TEXT NOT NULL,
  archived INTEGER NOT NULL,
  checkpoint_id TEXT,
  decided_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (decision_id)
) STRICT

-- table attribution
CREATE TABLE attribution (
  checkpoint_id TEXT NOT NULL,
  file_revision_id TEXT NOT NULL,
  agent_added INTEGER NOT NULL,
  human_added INTEGER NOT NULL,
  human_modified_agent INTEGER NOT NULL,
  agent_removed_by_human INTEGER NOT NULL,
  confidence_milli INTEGER NOT NULL,
  method_version TEXT NOT NULL,
  supersedes_pk TEXT,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (checkpoint_id, file_revision_id)
) STRICT

-- table attribution_hunk
CREATE TABLE attribution_hunk (
  checkpoint_id TEXT NOT NULL,
  file_revision_id TEXT NOT NULL,
  hunk_ordinal INTEGER NOT NULL,
  new_start INTEGER NOT NULL,
  new_len INTEGER NOT NULL,
  category TEXT NOT NULL,
  line_count INTEGER NOT NULL,
  confidence_milli INTEGER NOT NULL,
  method_version TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (checkpoint_id, file_revision_id, hunk_ordinal, category)
) STRICT

-- table capture_session_identity
CREATE TABLE capture_session_identity (
  session_id TEXT NOT NULL,
  agent TEXT NOT NULL,
  native_session_id TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (session_id),
  UNIQUE (agent, native_session_id)
) STRICT

-- table captured_event
CREATE TABLE captured_event (
  idempotency_key TEXT NOT NULL,
  session_id TEXT NOT NULL,
  turn_ordinal INTEGER NOT NULL,
  event_ordinal INTEGER NOT NULL,
  kind TEXT NOT NULL,
  trust TEXT NOT NULL,
  payload_sha256 TEXT NOT NULL,
  occurred_at_ms INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (idempotency_key)
) STRICT

-- table changed_hunk
CREATE TABLE changed_hunk (
  hunk_id TEXT NOT NULL,
  commit_id TEXT NOT NULL,
  file_revision_id TEXT NOT NULL,
  old_start INTEGER NOT NULL,
  old_len INTEGER NOT NULL,
  new_start INTEGER NOT NULL,
  new_len INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (hunk_id)
) STRICT

-- table checkpoint
CREATE TABLE checkpoint (
  checkpoint_id TEXT NOT NULL,
  strategy TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  merkle_root TEXT NOT NULL,
  prev_hash TEXT,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (checkpoint_id)
) STRICT

-- table checkpoint_commit
CREATE TABLE checkpoint_commit (
  checkpoint_id TEXT NOT NULL,
  commit_oid TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (checkpoint_id)
) STRICT

-- table checkpoint_worktree
CREATE TABLE checkpoint_worktree (
  checkpoint_id TEXT NOT NULL,
  worktree_token TEXT NOT NULL,
  worktree_name TEXT NOT NULL,
  is_linked INTEGER NOT NULL,
  branch TEXT,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (checkpoint_id)
) STRICT

-- table cost_fact
CREATE TABLE cost_fact (
  cost_fact_id TEXT NOT NULL,
  call_id TEXT NOT NULL,
  amount_micros INTEGER NOT NULL,
  valid_from INTEGER NOT NULL,
  valid_to INTEGER,
  recorded_at INTEGER NOT NULL,
  supersedes_id TEXT,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (cost_fact_id)
) STRICT

-- table developer_identity_snapshot
CREATE TABLE developer_identity_snapshot (
  snapshot_id TEXT NOT NULL,
  developer_id TEXT NOT NULL,
  git_author_name TEXT NOT NULL,
  git_email_normalized TEXT NOT NULL,
  machine_id TEXT NOT NULL,
  observed_at INTEGER NOT NULL,
  supersedes_id TEXT,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (snapshot_id)
) STRICT

-- table file_read_tokens
CREATE TABLE file_read_tokens (
  tool_call_id TEXT NOT NULL,
  input_tokens INTEGER NOT NULL,
  tokenizer TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (tool_call_id)
) STRICT

-- table file_revision
CREATE TABLE file_revision (
  file_revision_id TEXT NOT NULL,
  path TEXT NOT NULL,
  blob_oid TEXT NOT NULL,
  content_sha256 TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (file_revision_id),
  UNIQUE (path, blob_oid)
) STRICT

-- table imported_checkpoint
CREATE TABLE imported_checkpoint (
  import_id TEXT NOT NULL,
  source_id TEXT NOT NULL,
  source_layout TEXT NOT NULL CHECK (source_layout IN ('sharded-branch', 'per-checkpoint-refs')),
  source_root_claim TEXT,
  root_check TEXT NOT NULL CHECK (root_check IN ('self-consistent', 'mismatch', 'unclaimed', 'not-derivable')),
  imported_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (import_id)
) STRICT

-- table ingest_watermark
CREATE TABLE ingest_watermark (
  watermark_id TEXT NOT NULL,
  branch TEXT NOT NULL,
  branch_tip TEXT NOT NULL,
  ingested_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (watermark_id)
) STRICT

-- table key_metadata
CREATE TABLE key_metadata (
  key_id TEXT NOT NULL,
  repo_id TEXT NOT NULL,
  wrapped_dek BLOB NOT NULL,
  kek_ref TEXT NOT NULL,
  cipher TEXT NOT NULL,
  generation INTEGER NOT NULL,
  recorded_at INTEGER NOT NULL,
  supersedes_id TEXT,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (key_id)
) STRICT

-- table main_context_observation
CREATE TABLE main_context_observation (
  observation_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  model TEXT NOT NULL,
  observed_at INTEGER NOT NULL,
  uncached_input INTEGER NOT NULL,
  cached_input INTEGER NOT NULL,
  cache_creation INTEGER NOT NULL,
  output INTEGER NOT NULL,
  counter_method TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (observation_id)
) STRICT

-- table model_call
CREATE TABLE model_call (
  call_id TEXT NOT NULL,
  turn_id TEXT NOT NULL,
  model TEXT NOT NULL,
  started_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (call_id)
) STRICT

-- table model_observation
CREATE TABLE model_observation (
  observation_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  model TEXT NOT NULL,
  source TEXT NOT NULL,
  observed_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (observation_id)
) STRICT

-- table price_table
CREATE TABLE price_table (
  price_id TEXT NOT NULL,
  model TEXT NOT NULL,
  token_class TEXT NOT NULL,
  unit_price_micros INTEGER NOT NULL,
  currency TEXT NOT NULL,
  valid_from INTEGER NOT NULL,
  valid_to INTEGER,
  recorded_at INTEGER NOT NULL,
  supersedes_id TEXT,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (price_id),
  UNIQUE (model, token_class, valid_from, recorded_at)
) STRICT

-- table projection_meta
CREATE TABLE projection_meta (
  key TEXT NOT NULL,
  value INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (key)
) STRICT

-- table session
CREATE TABLE session (
  session_id TEXT NOT NULL,
  agent TEXT NOT NULL,
  model_primary TEXT NOT NULL,
  repo_id TEXT NOT NULL,
  started_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (session_id)
) STRICT

-- table session_binding
CREATE TABLE session_binding (
  binding_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  developer_id TEXT NOT NULL,
  machine_id TEXT NOT NULL,
  confidence_milli INTEGER NOT NULL,
  basis TEXT NOT NULL,
  recorded_at INTEGER NOT NULL,
  supersedes_id TEXT,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (binding_id)
) STRICT

-- table session_event
CREATE TABLE session_event (
  event_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  kind TEXT NOT NULL,
  occurred_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (event_id)
) STRICT

-- table session_in_checkpoint
CREATE TABLE session_in_checkpoint (
  checkpoint_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  ordinal INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (checkpoint_id, session_id)
) STRICT

-- table session_transition
CREATE TABLE session_transition (
  transition_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  from_state TEXT NOT NULL,
  to_state TEXT NOT NULL,
  trigger_kind TEXT NOT NULL,
  occurred_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (transition_id)
) STRICT

-- table session_worktree
CREATE TABLE session_worktree (
  observation_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  worktree_token TEXT NOT NULL,
  worktree_name TEXT NOT NULL,
  is_linked INTEGER NOT NULL,
  work_tree TEXT NOT NULL,
  branch TEXT,
  head_oid TEXT,
  subagent_id TEXT,
  basis TEXT NOT NULL CHECK (basis IN ('payload_cwd', 'workspace_path', 'process_cwd', 'commit', 'attach', 'import')),
  first_observed_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (observation_id)
) STRICT

-- table session_worktree_cd
CREATE TABLE session_worktree_cd (
  observation_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  worktree_token TEXT NOT NULL,
  worktree_name TEXT NOT NULL,
  is_linked INTEGER NOT NULL,
  work_tree TEXT NOT NULL,
  branch TEXT,
  head_oid TEXT,
  subagent_id TEXT,
  basis TEXT NOT NULL CHECK (basis IN ('payload_cwd', 'workspace_path', 'process_cwd', 'commit', 'attach', 'import', 'shell_cd')),
  first_observed_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (observation_id)
) STRICT

-- table shadow_branch
CREATE TABLE shadow_branch (
  shadow_branch_id TEXT NOT NULL,
  repo_id TEXT NOT NULL,
  base_commit TEXT NOT NULL,
  worktree_hash TEXT NOT NULL,
  branch_name TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (shadow_branch_id),
  UNIQUE (repo_id, base_commit, worktree_hash)
) STRICT

-- table shadow_branch_event
CREATE TABLE shadow_branch_event (
  event_id TEXT NOT NULL,
  shadow_branch_id TEXT NOT NULL,
  kind TEXT NOT NULL,
  occurred_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (event_id)
) STRICT

-- table subagent_session
CREATE TABLE subagent_session (
  child_session_id TEXT NOT NULL,
  parent_turn_id TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (child_session_id)
) STRICT

-- table substrate_block_event
CREATE TABLE substrate_block_event (
  block_id TEXT NOT NULL,
  verb TEXT NOT NULL,
  reason TEXT NOT NULL,
  occurred_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (block_id)
) STRICT

-- table substrate_install
CREATE TABLE substrate_install (
  install_id TEXT NOT NULL,
  substrate_sha256 TEXT NOT NULL,
  rift_release TEXT NOT NULL,
  install_root TEXT NOT NULL,
  verified_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (install_id)
) STRICT

-- table token_usage
CREATE TABLE token_usage (
  call_id TEXT NOT NULL,
  uncached_input INTEGER NOT NULL,
  cached_input INTEGER NOT NULL,
  cache_creation INTEGER NOT NULL,
  output INTEGER NOT NULL,
  counter_method TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (call_id)
) STRICT

-- table tool_call
CREATE TABLE tool_call (
  tool_call_id TEXT NOT NULL,
  turn_id TEXT NOT NULL,
  tool_name TEXT NOT NULL,
  started_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (tool_call_id)
) STRICT

-- table tool_edits_file
CREATE TABLE tool_edits_file (
  tool_call_id TEXT NOT NULL,
  file_revision_id TEXT NOT NULL,
  PRIMARY KEY (tool_call_id, file_revision_id)
) STRICT

-- table tool_reads_file
CREATE TABLE tool_reads_file (
  tool_call_id TEXT NOT NULL,
  file_revision_id TEXT NOT NULL,
  PRIMARY KEY (tool_call_id, file_revision_id)
) STRICT

-- table tool_result_tokens
CREATE TABLE tool_result_tokens (
  tool_result_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  tool_name TEXT NOT NULL,
  channel TEXT NOT NULL CHECK (channel IN ('read_tool', 'shell_read', 'search')),
  output_tokens INTEGER NOT NULL,
  tokenizer TEXT NOT NULL,
  basis TEXT NOT NULL CHECK (basis IN ('reexecuted', 'in_process', 'unmeasured')),
  recorded_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (tool_result_id)
) STRICT

-- table turn
CREATE TABLE turn (
  turn_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  ordinal INTEGER NOT NULL,
  started_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (turn_id),
  UNIQUE (session_id, ordinal)
) STRICT

-- table turn_boundary_file
CREATE TABLE turn_boundary_file (
  snapshot_id TEXT NOT NULL,
  path TEXT NOT NULL,
  blob_oid TEXT NOT NULL,
  content_sha256 TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (snapshot_id, path)
) STRICT

-- table turn_boundary_file_kind
CREATE TABLE turn_boundary_file_kind (
  snapshot_id TEXT NOT NULL,
  path TEXT NOT NULL,
  kind TEXT NOT NULL CHECK (kind IN ('regular', 'link', 'absent', 'unknown')),
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (snapshot_id, path)
) STRICT

-- table turn_boundary_gap_batch
CREATE TABLE turn_boundary_gap_batch (
  gap_id TEXT NOT NULL,
  repo_id TEXT NOT NULL,
  member_key TEXT NOT NULL,
  selection_sha256 TEXT NOT NULL,
  evidence_sha256 TEXT NOT NULL,
  ticket_count INTEGER NOT NULL,
  recorded_at INTEGER NOT NULL,
  reason TEXT NOT NULL CHECK (reason IN ('uncaptured-backlog')),
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (gap_id)
) STRICT

-- table turn_boundary_gap_ticket
CREATE TABLE turn_boundary_gap_ticket (
  gap_id TEXT NOT NULL,
  source_key TEXT NOT NULL,
  context_sha256 TEXT NOT NULL,
  ticket_sha256 TEXT NOT NULL,
  session_key TEXT NOT NULL,
  turn_ordinal INTEGER NOT NULL,
  boundary TEXT NOT NULL CHECK (boundary IN ('start', 'end')),
  head_oid TEXT,
  captured_at INTEGER NOT NULL,
  queued_at INTEGER NOT NULL,
  attempts INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (gap_id, source_key)
) STRICT

-- table turn_boundary_observation
CREATE TABLE turn_boundary_observation (
  snapshot_id TEXT NOT NULL,
  worktree_hash TEXT NOT NULL,
  collection_started_at INTEGER NOT NULL,
  collection_finished_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (snapshot_id)
) STRICT

-- table turn_boundary_snapshot
CREATE TABLE turn_boundary_snapshot (
  snapshot_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  turn_ordinal INTEGER NOT NULL,
  boundary TEXT NOT NULL,
  actor TEXT NOT NULL,
  worktree_hash TEXT NOT NULL,
  captured_at INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (snapshot_id),
  UNIQUE (session_id, turn_ordinal, boundary)
) STRICT

-- table turn_diff_hunk
CREATE TABLE turn_diff_hunk (
  hunk_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  turn_ordinal INTEGER NOT NULL,
  edit_kind TEXT NOT NULL,
  path TEXT NOT NULL,
  old_start INTEGER NOT NULL,
  old_len INTEGER NOT NULL,
  new_start INTEGER NOT NULL,
  new_len INTEGER NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (hunk_id)
) STRICT

-- table verification_divergence
CREATE TABLE verification_divergence (
  run_id TEXT NOT NULL,
  ordinal INTEGER NOT NULL,
  checkpoint_id TEXT NOT NULL,
  layer TEXT NOT NULL,
  site TEXT NOT NULL,
  detail TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (run_id, ordinal)
) STRICT

-- table verification_run
CREATE TABLE verification_run (
  run_id TEXT NOT NULL,
  branch TEXT NOT NULL,
  exit_code INTEGER NOT NULL,
  checked_at INTEGER NOT NULL,
  outcome_sha256 TEXT NOT NULL,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (run_id)
) STRICT

-- table verification_witness
CREATE TABLE verification_witness (
  run_id TEXT NOT NULL,
  checkpoint_id TEXT NOT NULL,
  chain_head TEXT,
  schema_version INTEGER NOT NULL,
  PRIMARY KEY (run_id, checkpoint_id)
) STRICT

