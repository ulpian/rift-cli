-- table canopy_profile_theme_event
CREATE TABLE canopy_profile_theme_event (
  event_id TEXT NOT NULL,
  profile_id TEXT NOT NULL,
  slot TEXT NOT NULL,
  colour TEXT,
  supersedes TEXT,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (event_id)
) STRICT

-- table canopy_project_event
CREATE TABLE canopy_project_event (
  event_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  op TEXT NOT NULL,
  repo_id TEXT,
  path TEXT,
  label TEXT,
  order_key INTEGER,
  supersedes TEXT,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (event_id)
) STRICT

-- table canopy_toggle_event
CREATE TABLE canopy_toggle_event (
  event_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  feature TEXT NOT NULL,
  desired INTEGER NOT NULL,
  supersedes TEXT,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (event_id)
) STRICT

-- trigger canopy_layout_event_no_delete
CREATE TRIGGER canopy_layout_event_no_delete BEFORE DELETE ON canopy_layout_event BEGIN SELECT RAISE(ABORT, 'rift: canopy_layout_event is append-only (DELETE forbidden)'); END

-- trigger canopy_layout_event_no_update
CREATE TRIGGER canopy_layout_event_no_update BEFORE UPDATE ON canopy_layout_event BEGIN SELECT RAISE(ABORT, 'rift: canopy_layout_event is append-only (UPDATE forbidden)'); END

