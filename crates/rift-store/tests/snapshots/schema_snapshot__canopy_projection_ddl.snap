-- table _migrations
CREATE TABLE _migrations (
version    INTEGER PRIMARY KEY,
name       TEXT    NOT NULL,
checksum   TEXT    NOT NULL,
applied_at TEXT    NOT NULL
) STRICT

-- table _schema_version
CREATE TABLE _schema_version (
table_name     TEXT PRIMARY KEY,
schema_version INTEGER NOT NULL
) STRICT

-- table canopy_layout_event
CREATE TABLE canopy_layout_event (
  event_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  layout TEXT,
  supersedes TEXT,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (event_id)
) STRICT

-- table canopy_profile_event
CREATE TABLE canopy_profile_event (
  event_id TEXT NOT NULL,
  profile_id TEXT NOT NULL,
  op TEXT NOT NULL,
  name TEXT,
  supersedes TEXT,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (event_id)
) STRICT

-- table canopy_profile_layout_event
CREATE TABLE canopy_profile_layout_event (
  event_id TEXT NOT NULL,
  profile_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  layout TEXT,
  supersedes TEXT,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (event_id)
) STRICT

-- table canopy_profile_project_event
CREATE TABLE canopy_profile_project_event (
  event_id TEXT NOT NULL,
  profile_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  op TEXT NOT NULL,
  order_key INTEGER,
  supersedes TEXT,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (event_id)
) STRICT

-- table canopy_profile_startup_event
CREATE TABLE canopy_profile_startup_event (
  event_id TEXT NOT NULL,
  profile_id TEXT,
  supersedes TEXT,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (event_id)
